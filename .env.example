# ===== 复制为 .env 后填写（SPEC §12 全大写 + 小写转大写兜底）=====
# 环境变量加载（Next 内置 + 独立脚本 db/load-env.ts 一致）：
#   .env → .env.local → .env.<NODE_ENV> → .env.<NODE_ENV>.local，后者覆盖前者
# 本地差异配置建议放 .env.local（已被 gitignore 忽略，不会误提交）

# 数据库（Neon 控制台获取；应用用池化 URL，迁移用非池化 URL）
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# 认证（Better Auth）
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 存储驱动（三选一：LOCAL 本地 / GITHUB GitHub图床 / S3 S3兼容）
# 开发默认 LOCAL，生产推荐 GITHUB（jsDelivr CDN 加速）
# 注：SPEC 原定义为 VERCEL_BLOB|S3|GITHUB，用户否决 VERCEL_BLOB，改用 LOCAL 本地驱动
STORAGE_DRIVER=LOCAL

# GitHub 图床（STORAGE_DRIVER=GITHUB 时需要）
# GITHUB_STORAGE_TOKEN：GitHub Personal Access Token（需要 repo 权限）
# GITHUB_STORAGE_OWNER：仓库所有者（如 lsx-xyg）
# GITHUB_STORAGE_REPO：仓库名（如 images）
# GITHUB_STORAGE_BRANCH：分支名（默认 main）
# GITHUB_STORAGE_CDN_BASE：CDN 基础 URL（默认 https://cdn.jsdelivr.net/gh）
GITHUB_STORAGE_TOKEN=
GITHUB_STORAGE_OWNER=lsx-xyg
GITHUB_STORAGE_REPO=images
GITHUB_STORAGE_BRANCH=main
GITHUB_STORAGE_CDN_BASE=https://cdn.jsdelivr.net/gh

# S3 兼容存储（STORAGE_DRIVER=S3 时需要，占位未实现）
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# 定时
CRON_SECRET=
DEPLOY_PLATFORM=VERCEL

# 后台入口
ADMIN_PATH=
SETUP_SECRET=

# 搜索
SEARCH_MODE=CLIENT

# 备份
BACKUP_DRIVER=LOCAL
BACKUP_RETENTION=7

# 站点信息（SEO / RSS / sitemap）
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=林圣轩blog
NEXT_PUBLIC_SITE_DESCRIPTION=技术写作与生活记录

# giscus 评论（GitHub Discussions 驱动，仓库必须公开且已开启 Discussions）
# 从 https://giscus.app 获取 repoId 和 categoryId
NEXT_PUBLIC_GISCUS_REPO=lsx-xyg/blog
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
