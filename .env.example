# =============================================================================
# 林圣轩blog - 环境变量配置示例
# =============================================================================
# 使用方法：
#   1. 复制本文件为 .env（通用配置）或 .env.local（本地私有配置，已被 gitignore）
#   2. 根据下方说明填写配置值
#   3. 本地开发：npm run dev
#
# 加载优先级（后者覆盖前者）：
#   .env → .env.local → .env.<NODE_ENV> → .env.<NODE_ENV>.local
#
# 配置优先级（运行时）：
#   环境变量 > 数据库 settings 表（后台动态配置）> 代码默认值
#   即：设置了环境变量，后台配置就不生效；想使用后台动态配置，就不设对应环境变量
#
# 命名规范：全大写下划线分隔，枚举值全大写（LOCAL/GITHUB/S3/VERCEL/SERVER）
# =============================================================================


# =============================================================================
# 【必须配置】数据库
# =============================================================================
# Neon PostgreSQL 连接字符串
# - DATABASE_URL：池化连接（应用运行时用，hostname 带 -pooler 后缀）
# - DATABASE_URL_UNPOOLED：直连（数据库迁移/脚本用，hostname 不带 -pooler）
# 获取方式：Neon 控制台 → 项目 → Connection Details
DATABASE_URL=
DATABASE_URL_UNPOOLED=


# =============================================================================
# 【必须配置】认证（Better Auth + GitHub OAuth）
# =============================================================================
# BETTER_AUTH_SECRET：Better Auth 加密密钥（用于 session 签名等）
#   生成方式：openssl rand -hex 32
# BETTER_AUTH_URL：应用根 URL（本地开发用 http://localhost:3000）
# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET：GitHub OAuth App 凭证
#   申请地址：https://github.com/settings/developers
#   Authorization callback URL：{BETTER_AUTH_URL}/api/auth/callback/github
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# =============================================================================
# 【必须配置】加密密钥（敏感信息加密存储）
# =============================================================================
# ENCRYPTION_KEY：AES-256-GCM 加密密钥，用于加密存储 GitHub Token、S3 Key 等敏感信息
#   生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   重要：生产环境必须配置！未配置时敏感信息会明文存储（有警告日志）
#   注意：密钥一旦设定不要更改，否则已加密的数据无法解密
ENCRYPTION_KEY=


# =============================================================================
# 【按需配置】存储驱动
# =============================================================================
# STORAGE_DRIVER：选择存储驱动（三选一）
#   LOCAL  - 本地文件存储（开发环境默认，生产环境不推荐，Vercel 无持久化文件系统）
#   GITHUB - GitHub 图床（生产推荐，免费 + jsDelivr CDN 全球加速）
#   S3     - S3 兼容存储（阿里云 OSS / Cloudflare R2 / AWS S3 / MinIO 等，占位未实现）
#
# 优先级：环境变量 > 后台存储设置 > 默认值 LOCAL
# 想在后台动态切换驱动，就不设置此环境变量
STORAGE_DRIVER=LOCAL


# -----------------------------------------------------------------------------
# 【按需配置】GitHub 图床（STORAGE_DRIVER=GITHUB 时需要）
# -----------------------------------------------------------------------------
# 以下配置也可以在后台「存储设置」中动态配置（加密存储）
# 设置了环境变量，后台配置就不生效
#
# GITHUB_STORAGE_TOKEN：GitHub Personal Access Token（需要 repo 权限）
#   申请地址：https://github.com/settings/tokens
# GITHUB_STORAGE_OWNER：仓库所有者（用户名或组织名，如 lsx-xyg）
# GITHUB_STORAGE_REPO：仓库名（如 images，建议单独建一个仓库存图片）
# GITHUB_STORAGE_BRANCH：分支名（默认 main）
# GITHUB_STORAGE_CDN_BASE：CDN 基础 URL（默认 https://cdn.jsdelivr.net/gh）
#   访问 URL 格式：{CDN_BASE}/{OWNER}/{REPO}@{BRANCH}/{文件路径}
GITHUB_STORAGE_TOKEN=
GITHUB_STORAGE_OWNER=lsx-xyg
GITHUB_STORAGE_REPO=images
GITHUB_STORAGE_BRANCH=main
GITHUB_STORAGE_CDN_BASE=https://cdn.jsdelivr.net/gh


# -----------------------------------------------------------------------------
# 【按需配置】S3 兼容存储（STORAGE_DRIVER=S3 时需要，占位未实现）
# -----------------------------------------------------------------------------
# 支持阿里云 OSS、Cloudflare R2、AWS S3、MinIO 等 S3 兼容平台
# 以下配置也可以在后台「存储设置」中动态配置（加密存储）
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=


# =============================================================================
# 【按需配置】后台入口
# =============================================================================
# ADMIN_PATH：后台管理路径（默认 admin）
#   如设置为 dashboard，则后台地址为 /dashboard
#   也可以在后台「高级设置」中动态配置（环境变量优先级更高）
#   安全建议：设置一个不容易猜到的路径，避免被暴力扫描
ADMIN_PATH=


# =============================================================================
# 【按需配置】站点信息（SEO / RSS / sitemap）
# =============================================================================
# 以下配置也可以在后台「站点设置」中动态配置
# 设置了环境变量，后台配置就不生效
#
# NEXT_PUBLIC_SITE_URL：站点根 URL（生产环境必须配置，用于 sitemap/RSS/OG 卡片）
# NEXT_PUBLIC_SITE_NAME：站点名称
# NEXT_PUBLIC_SITE_DESCRIPTION：站点描述（SEO 用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=林圣轩blog
NEXT_PUBLIC_SITE_DESCRIPTION=技术写作与生活记录


# =============================================================================
# 【按需配置】giscus 评论系统
# =============================================================================
# GitHub Discussions 驱动的评论系统，仓库必须公开且已开启 Discussions
# 配置获取：https://giscus.app
#
# NEXT_PUBLIC_GISCUS_REPO：仓库（owner/repo 格式）
# NEXT_PUBLIC_GISCUS_REPO_ID：仓库 ID（从 giscus.app 获取）
# NEXT_PUBLIC_GISCUS_CATEGORY：讨论分类名（如 Announcements）
# NEXT_PUBLIC_GISCUS_CATEGORY_ID：分类 ID（从 giscus.app 获取）
NEXT_PUBLIC_GISCUS_REPO=lsx-xyg/blog
NEXT_PUBLIC_GISCUS_REPO_ID=R_kgDOUVJQpg
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOUVJQps4DFcnk


# =============================================================================
# 【按需配置】定时任务（T12 文章定时发布）
# =============================================================================
# 两套实现，通过 DEPLOY_PLATFORM 切换：
# - VERCEL：使用 cron-job.org 外部定时任务（推荐，Vercel serverless 无持久化进程）
# - SERVER：使用 node-cron 内置定时任务（自有服务器时使用）
#
# 工作原理：
# 1. 文章设置定时发布时间后，status = SCHEDULED
# 2. 定时任务每分钟扫描一次，发布所有到期的文章
# 3. 幂等设计：已发布的文章不会重复发布
#
# CRON_SECRET：定时任务接口鉴权密钥（必须配置，防止未授权访问）
#   生成方式：openssl rand -hex 32
# DEPLOY_PLATFORM：部署平台（VERCEL/SERVER，默认 VERCEL）
# CRON_JOB_API_KEY：cron-job.org API Key（VERCEL 模式下需要，用于创建定时任务）
#   获取地址：https://cron-job.org/en/members/settings/
CRON_SECRET=
DEPLOY_PLATFORM=VERCEL
CRON_JOB_API_KEY=


# =============================================================================
# 【预留配置】以下功能尚未实现，预留环境变量
# =============================================================================

# 搜索（已实现纯客户端搜索，数据库全文搜索预留）
# SEARCH_MODE：搜索模式（CLIENT=客户端 minisearch / DATABASE=数据库全文搜索）
# SEARCH_MODE=CLIENT

# 备份（T13 未实现）
# BACKUP_DRIVER：备份存储驱动（LOCAL/GITHUB/S3）
# BACKUP_RETENTION：备份保留天数（默认 7）
# BACKUP_DRIVER=LOCAL
# BACKUP_RETENTION=7
