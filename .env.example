# ===== 复制为 .env 后填写（SPEC §12 全大写 + 小写转大写兜底）=====

# 数据库（Neon 控制台获取；应用用池化 URL，迁移用非池化 URL）
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# 认证（Better Auth）
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 存储（三选一）
STORAGE_DRIVER=VERCEL_BLOB
BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
GITHUB_STORAGE_TOKEN=
GITHUB_STORAGE_OWNER=
GITHUB_STORAGE_REPO=
GITHUB_STORAGE_BRANCH=
GITHUB_STORAGE_CDN_BASE=

# 定时
CRON_SECRET=
DEPLOY_PLATFORM=VERCEL

# 后台入口
ADMIN_PATH=
SETUP_SECRET=

# 搜索
SEARCH_MODE=CLIENT

# 备份
BACKUP_DRIVER=LOCAL
BACKUP_RETENTION=7

# 站点
NEXT_PUBLIC_SITE_URL=
